{
  "name": "lucid-launcher",
  "productName": "LUCID Launcher",
  "version": "2.1.1",
  "description": "Instance-based Minecraft launcher for LUCID",
  "license": "MIT",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "build:client": "node scripts/build-client.mjs",
    "dist": "npm run build:client && npm run build && electron-builder --win --publish never",
    "dist:store": "npm run build:client && npm run build && electron-builder --win appx --publish never",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "dist:verify": "npm run dist && npm run verify:signature",
    "dist:linux": "npm run build:client && npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "build": {
    "appId": "dev.lucid.launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "app-config.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/build/libs/launcher",
        "to": "client",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "icon": "build-resources/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LUCID-${version}-win.${ext}",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": [
          "LUCID"
        ]
      },
      "verifyUpdateCodeSignature": true
    },
    "portable": {
      "artifactName": "LUCID-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "LUCID-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build-resources/installer/icon.ico",
      "uninstallerIcon": "build-resources/installer/icon.ico",
      "installerHeaderIcon": "build-resources/installer/icon.ico",
      "installerSidebar": "build-resources/installer/sidebar.bmp",
      "uninstallerSidebar": "build-resources/installer/uninstall-sidebar.bmp",
      "installerHeader": "build-resources/installer/header.bmp",
      "include": "build-resources/installer/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build-resources/icon.png",
      "artifactName": "LUCID-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "maintainer": "LUCID contributors",
      "artifactName": "LUCID-${version}-linux-${arch}.${ext}",
      "executableName": "lucid",
      "syncDesktopName": true
    },
    "appx": {
      "identityName": "LUCID.Launcher",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "LUCID",
      "applicationId": "LUCID",
      "displayName": "LUCID",
      "backgroundColor": "#05070a",
      "languages": [
        "en-US"
      ],
      "artifactName": "LUCID-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NUMZSY",
        "repo": "LUCID",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "LUCID ${version}",
      "artifactName": "LUCID-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": {
    "name": "LUCID contributors"
  },
  "homepage": "https://github.com/NUMZSY/LUCID",
  "desktopName": "LUCID"
}
